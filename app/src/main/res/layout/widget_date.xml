    <TextView android:id="@+id/date_add" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="+" android:textSize="24sp" android:textColor="@color/todo_text" android:contentDescription="@string/new_todo" />
</LinearLayout>
