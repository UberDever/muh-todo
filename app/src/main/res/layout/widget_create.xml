<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/create_entry" android:layout_width="match_parent" android:layout_height="40dp"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="12dp" android:paddingEnd="12dp" android:contentDescription="@string/new_todo">
    <TextView android:id="@+id/create_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:text="@string/new_entry" android:textSize="12sp" android:textColor="@color/todo_secondary_text" />
    <TextView android:id="@+id/entry_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="@color/todo_secondary_text" />
</LinearLayout>
