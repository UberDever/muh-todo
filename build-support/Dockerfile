# Context is generated by scripts/archive-build-environment.sh, not the raw checkout.
FROM eclipse-temurin@sha256:b468c3fc688b14450571494f588bd939378e7fd542ed5a73f8efc13f17872a87
COPY toolchain/sdk /workspace/.android-sdk
COPY toolchain/gradle /workspace/.gradle
COPY toolchain/debug.keystore /workspace/.muh-todo/debug.keystore
COPY source /workspace/muh-todo
ENV ANDROID_HOME=/workspace/.android-sdk \
    ANDROID_SDK_ROOT=/workspace/.android-sdk \
    ANDROID_USER_HOME=/root/.android \
    GRADLE_USER_HOME=/workspace/.gradle \
    MUH_TODO_DEBUG_KEYSTORE=/workspace/.muh-todo/debug.keystore
WORKDIR /workspace/muh-todo
ENTRYPOINT ["./gradlew", "--no-daemon", "--offline"]
CMD [":app:assembleDebug"]
